{% set successMessages = app.flashes('success') %}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-full">
<head>
    {% set page_title %}
        {% block title %}Lucas Bruel | Portfolio{% endblock %}
    {% endset %}

    {% include "base/baseHeader.html.twig" with { page_title: page_title } %}
</head>

<body class="min-h-screen flex flex-col">
        {# OVERLAY #}
        <div
            id="loading-overlay"
            class="fixed inset-0 z-100 hidden items-center justify-center bg-black/50 backdrop-blur-sm"
        >
            <div role="status">
                <svg aria-hidden="true" class="h-10 w-10 animate-spin fill-cyan-500 text-gray-600" viewBox="0 0 100 101" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z" fill="currentColor"/>
                    <path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill"/>
                </svg>
                <span class="sr-only">Chargement...</span>
            </div>
        </div>
        {# OVERLAY #}
    {% include "components/menu.html.twig" %}

    <main class="flex flex-1 flex-col bg-slate-900 text-white">


            {% if successMessages is not empty %}
                <div id="alert-1" class="mx-auto max-w-6xl flex sm:items-center p-4 mb-4 text-sm text-fg-success-strong rounded-base bg-success-subtle" role="alert">
                    <svg class="w-4 h-4 shrink-0 mt-0.5 md:mt-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                    </svg>
                    <span class="sr-only">Info</span>
                    <div class="ms-2 text-sm">
                        {% for message in successMessages %}
                            <div class="ms-2 text-sm">{{ message }}</div>
                        {% endfor %}
                    </div>
                    <button type="button" class="ms-auto -mx-1.5 -my-1.5 rounded focus:ring-2 focus:ring-brand-medium hover:bg-success-subtle inline-flex items-center justify-center h-8 w-8 shrink-0" data-dismiss-target="#alert-1" aria-label="Close">
                        <span class="sr-only">Close</span>
                        <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/>
                        </svg>
                    </button>
                </div>
            {% endif %}
        {% block body %}{% endblock %}
    </main>

    {% block footer %}
        {% include "components/footer.html.twig" %}
    {% endblock %}

</body>
</html>