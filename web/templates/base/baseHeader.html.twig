{% include "base/baseIncludeCss.html.twig" %}
{% block baseHeader %}
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="{{ asset('images/favicon.png') }}">
    <title>{{ page_title }}</title>

    <meta
        name="description"
        content="{{ page_meta_description|striptags|trim }}"
    >
        
    <meta name="robots" content="{{ page_meta_robots|striptags|trim }}">

    {% if seo_canonical_url %}
        <link rel="canonical" href="{{ seo_canonical_url }}">
        {% for alternate in seo_alternate_urls %}
            <link rel="alternate" hreflang="{{ alternate.hreflang }}" href="{{ alternate.href }}">
        {% endfor %}
    {% endif %}

    {# Open Graph — partage Facebook, LinkedIn, etc. #}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ page_title|striptags|trim }}">
    <meta property="og:description" content="{{ page_meta_description|striptags|trim }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ page_title|striptags|trim }}">
    <meta name="twitter:description" content="{{ page_meta_description|striptags|trim }}">

	{% block styleSheets %}{% endblock %}
{% block javascripts %}
	{{ encore_entry_script_tags('app') }}

{% endblock %}

{% endblock %}
