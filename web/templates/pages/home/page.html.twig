{% trans_default_domain 'homepage' %}
{% extends "base/basePage.html.twig" %}

{% block title %}Lucas Bruel | Game Dev Portfolio
{% endblock %}

{% block body %}
    {% set locale = app.request.locale|default('fr') %}
    <section class="mx-auto max-w-6xl px-6 py-16">
        <header class="mb-12 opacity-100 transition-all duration-700 ease-out delay-150">
            <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-cyan-300 transition-all duration-500 ease-out hover:text-cyan-200">
                Portfolio UI Game Developer
            </p>
            <h1 class="text-4xl font-extrabold transition-all duration-700 ease-out hover:tracking-wide">Lucas Bruel - Game Developer</h1>
            <p class="mt-3 max-w-3xl text-slate-300 transition-all duration-500 ease-out">
                {{ 'about.presentation'|trans }}
            </p>
        </header>

        <section id="about" class="mb-10 grid gap-6 opacity-100 transition-all duration-700 ease-out md:grid-cols-3">
            <div class="col-span-2 rounded-lg bg-slate-800 p-6 shadow-xl shadow-slate-950/20 transition-all duration-500 ease-out hover:-translate-y-1 hover:shadow-cyan-500/10">
                <h2 class="text-2xl font-bold">{{ 'about.title'|trans }}</h2>
                <p class="mt-3 text-slate-300">
                    {{ 'about.description'|trans }}
                </p>
            </div>

            <aside class="rounded-lg bg-slate-800 p-6 shadow-xl shadow-slate-950/20 transition-all duration-500 ease-out hover:-translate-y-1 hover:shadow-cyan-500/10">
                <h3 class="text-lg font-semibold">{{ locale == 'en' ? 'Contact' : 'Contact' }}</h3>

                <p class="mt-2 text-sm text-slate-300">GitHub:
                    <a href="https://github.com/Lurius-Kitsune" target="_blank" rel="noopener noreferrer" class="text-cyan-300">Lurius-Kitsune</a>
                </p>
                <p class="mt-2 text-sm text-slate-300">LinkedIn:
                    <a href="https://www.linkedin.com/in/lucas-bruel-547179278/?trk=public_post_comment_actor-image" target="_blank" rel="noopener noreferrer" class="text-cyan-300">Lucas Bruel</a>
                </p>
            </aside>
        </section>

        {% include 'pages/home/hardSkills.html.twig' %}
        {% if careerEntries is not empty %}
            <section id="career" class="mb-16" aria-labelledby="career-heading" data-controller="career-timeline">
                <header class="mb-8 text-center">
                    <p class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">{{ 'career.timelineEyebrow'|trans }}</p>
                    <h2 id="career-heading" class="text-3xl font-black tracking-tight text-white sm:text-4xl">{{ 'career.timelineTitle'|trans }}</h2>
                </header>

                <div class="relative" data-career-timeline-target="container">
                    <svg
                        class="pointer-events-none absolute inset-0 h-full w-full overflow-visible"
                        data-career-timeline-target="svg"
                        preserveAspectRatio="none"
                        aria-hidden="true"
                    >
                        <path class="career-timeline__track" data-career-timeline-target="trackPath" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                        <path class="career-timeline__progress" data-career-timeline-target="progressPath" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>

                    <ol class="relative space-y-7 py-2 md:space-y-10">
                        {% for entry in careerEntries %}
                            <li class="career-timeline__entry grid grid-cols-[1.75rem_minmax(0,1fr)] gap-x-4 md:grid-cols-[minmax(0,1fr)_3.5rem_minmax(0,1fr)] md:gap-x-5" data-career-timeline-target="entry">
                                <div class="relative z-10 col-start-1 row-start-1 flex justify-center md:col-start-2">
                                    <span class="mt-1 h-3.5 w-3.5 rounded-full border-[3px] border-cyan-300 bg-slate-950 shadow-[0_0_14px_rgba(103,232,249,0.45)] {% if loop.index is odd %}md:translate-x-5{% else %}md:-translate-x-5{% endif %}" data-career-timeline-target="marker"></span>
                                </div>

                                <article class="col-start-2 row-start-1 min-w-0 rounded-2xl border border-slate-700/80 bg-slate-800/90 p-5 shadow-xl shadow-slate-950/20 transition-colors hover:border-cyan-500/40 sm:p-6 {% if loop.index is odd %}md:col-start-1 md:text-right{% else %}md:col-start-3 md:text-left{% endif %}">
                                    <div class="mb-3 flex flex-wrap items-center gap-3 {% if loop.index is odd %}md:justify-end{% endif %}">
                                        <span class="rounded-full border px-3 py-1 text-xs font-semibold {% if entry.category == 'education' %}border-cyan-400/30 bg-cyan-400/10 text-cyan-200{% else %}border-violet-400/30 bg-violet-400/10 text-violet-200{% endif %}">
                                            {{ entry.category == 'education' ? 'education.title'|trans : 'experience.title'|trans }}
                                        </span>
                                        <p class="text-sm font-medium tabular-nums text-slate-400">
                                            <time datetime="{{ entry.startDate|date('Y-m-d') }}">{{ entry.startDate|date('m/Y') }}</time>
                                            – {% if entry.endDate %}<time datetime="{{ entry.endDate|date('Y-m-d') }}">{{ entry.endDate|date('m/Y') }}</time>{% else %}{{ 'career.current'|trans }}{% endif %}
                                        </p>
                                    </div>
                                    <h3 class="text-lg font-bold text-white sm:text-xl">{{ entry.title }}</h3>
                                    <p class="mt-1 font-medium text-cyan-300">{{ entry.organization }}</p>
                                    {% if entry.description %}
                                        <p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-300">{{ entry.description }}</p>
                                    {% endif %}
                                </article>
                            </li>
                        {% endfor %}
                    </ol>
                </div>
            </section>
        {% endif %}
        <section id="projects" class="mb-10 opacity-100 transition-all duration-700 ease-out">
            <h2 class="text-center text-3xl font-black tracking-tight text-white transition-all duration-500 ease-out md:text-4xl pb-2">{{ 'projects.title'|trans }}</h2>
            {% for projectType in projects %}
                {% include 'components/projectCaroussel.html.twig' with {objects: projectType.projects, locale: locale} %}
            {% endfor %}
        </section>
    </section>
{% endblock %}
