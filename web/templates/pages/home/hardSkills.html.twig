{% trans_default_domain 'homepage' %}

{% block hardSkills %}
	<section class="mb-20 py-12 opacity-100 transition-all duration-700 ease-out">
		<div class="mb-8 text-center">
			<h2 class="text-3xl font-black tracking-tight text-white transition-all duration-500 ease-out md:text-4xl">{{ 'skills.title'|trans }}</h2>
		</div>
		<div class="grid gap-10 transition-all duration-700 ease-out lg:grid-cols-2">
			<div class="space-y-12">
				{% for group in skillGroups|slice(0, 3) %}
					{% include 'components/skills/skillGroup.html.twig' with { group: group } %}
				{% endfor %}
			</div>

			<div class="space-y-12">
				{% for group in skillGroups|slice(3) %}
					{% include 'components/skills/skillGroup.html.twig' with { group: group } %}
				{% endfor %}
			</div>
		</div>
	</section>
{% endblock %}
