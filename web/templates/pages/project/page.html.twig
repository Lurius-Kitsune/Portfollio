{% trans_default_domain 'project' %}
{% extends "base/basePage.html.twig" %}

{% block title %}
	{{ project.name }}
	| Portfolio
{% endblock %}

{% block body %}
	<section class="mx-auto max-w-6xl px-6 py-16">
		<a href="{{ path('homepage', { _locale: app.request.locale|default('fr') }) }}#projects" class="mb-8 inline-flex items-center text-sm font-semibold text-cyan-300 transition-colors hover:text-cyan-200">
			&larr;
			{{ 'backtohome'|trans }}
		</a>

		<article class="overflow-hidden rounded-lg bg-slate-800 shadow-xl shadow-slate-950/20">
			{% if project.thumbnailUrl is not empty %}
				<div class="h-64 overflow-hidden bg-slate-700 md:h-96">
					<img src="{{ project.thumbnailUrl }}" alt="{{ project.name }}" class="h-full w-full object-cover">
				</div>
			{% else %}
				<div class="flex h-64 items-center justify-center bg-slate-700 text-slate-400 md:h-96">
					{{ 'nothumbnail'|trans() }}
				</div>
			{% endif %}


			<div class="p-6 md:p-10">
				<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
					<div>
						<p class="mb-2 text-sm font-medium uppercase tracking-[0.2em] text-cyan-300">{{ project.type.name }}</p>
						<h1 class="text-3xl font-extrabold text-white md:text-5xl">{{ project.name }}</h1>
					</div>

					{% if project.link is not empty %}
						<a href="{{ project.link }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-md bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300 focus:outline-none focus:ring-2 focus:ring-cyan-400">
							{{ 'info.link'|trans }}
						</a>
					{% endif %}
				</div>

				<div class="mb-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-slate-300">
					<span>{{ 'info.start'|trans }}
						{{ project.startYear ? project.startYear|date('m/Y') : '-' }}</span>
					{% if project.endDate %}
						<span>{{ 'info.end'|trans }}
							{{ project.endDate|date('m/Y') }}</span>
					{% endif %}
				</div>

				{% if project.tags is not empty %}
					<div class="flex flex-wrap gap-2">
						{% for tag in project.tags %}
							<span class="rounded-full bg-slate-700 px-3 py-1 text-sm text-slate-300">{{ tag }}</span>
						{% endfor %}
					</div>
				{% endif %}
			</div>
			{% if project.content is not empty %}
				<div class="prose max-w-none p-6 text-slate-300 md:p-10">
					{{ project.content|raw }}
				</div>
			{% endif %}
		</article>
	</section>
{% endblock %}
