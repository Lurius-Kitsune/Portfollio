{% trans_default_domain 'homepage' %}
{% extends "base/basePage.html.twig" %}

{% block title %}Lucas Bruel | Game Dev Portfolio
{% endblock %}

{% block body %}
	{% set locale = app.request.locale|default('fr') %}
	<section class="mx-auto max-w-6xl px-6 py-16">
		<header class="mb-12">
			<p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-cyan-300">
				Portfolio Game Developer
			</p>
			<h1 class="text-4xl font-extrabold">Lucas Bruel - Game Developer</h1>
			<p class="mt-3 max-w-3xl text-slate-300">
				{{ 'about.presentation'|trans }}
			</p>
		</header>

		<section id="about" class="mb-10 grid gap-6 md:grid-cols-3">
			<div class="col-span-2 rounded-lg bg-slate-800 p-6 shadow-xl shadow-slate-950/20">
				<h2 class="text-2xl font-bold">{{ 'about.title'|trans }}</h2>
				<p class="mt-3 text-slate-300">
					{{ 'about.description'|trans }}
				</p>
			</div>

			<aside class="rounded-lg bg-slate-800 p-6 shadow-xl shadow-slate-950/20">
				<h3 class="text-lg font-semibold">{{ locale == 'en' ? 'Contact' : 'Contact' }}</h3>
				<p class="mt-2 text-sm text-slate-300">Email:
					<a href="mailto:lucas@example.com" class="text-cyan-300">lucas@example.com</a>
				</p>
				<p class="mt-2 text-sm text-slate-300">GitHub:
					<a href="https://github.com/Lurius-Kitsune" target="_blank" rel="noopener noreferrer" class="text-cyan-300">Lurius-Kitsune</a>
				</p>
				<p class="mt-2 text-sm text-slate-300">LinkedIn:
					<a href="https://www.linkedin.com/in/lucas-bruel-547179278/?trk=public_post_comment_actor-image" target="_blank" rel="noopener noreferrer" class="text-cyan-300">Lucas Bruel</a>
				</p>
			</aside>
		</section>

<section class="mb-20 py-12">
	<div class="grid gap-10 lg:grid-cols-2">
		<div class="space-y-12">
			{% for group in skillGroups|slice(0, 3) %}
				{% include 'components/skills/skillGroup.html.twig' with { group: group } %}
			{% endfor %}
		</div>

		<div class="space-y-12">
			{% for group in skillGroups|slice(3) %}
				{% include 'components/skills/skillGroup.html.twig' with { group: group } %}
			{% endfor %}
		</div>
	</div>
</section>


<section id="professionalProjects" class="mb-20">
	<h2 class="mb-6 text-2xl font-bold">{{ locale == 'en' ? 'Professional Projects' : 'Projets professionnels' }}</h2>
	<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
		{% for project in projects %}
			{% include 'components/projectCard.html.twig' with { project: project, locale: locale } %}
		{% else %}
			<div class="rounded-lg bg-slate-800 p-6 text-slate-300">
				{{ locale == 'en' ? 'No project available yet.' : 'Aucun projet disponible pour le moment.' }}
			</div>
		{% endfor %}
	</div>
</section>

<section id="personalProjects" class="mb-20">

	<h2 class="mb-6 text-2xl font-bold">{{ locale == 'en' ? 'Personal Projects' : 'Projets personnels' }}</h2>
	<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
		{% for project in projects %}
			{% include 'components/projectCard.html.twig' with { project: project, locale: locale } %}
		{% else %}
			<div class="rounded-lg bg-slate-800 p-6 text-slate-300">
				{{ locale == 'en' ? 'No project available yet.' : 'Aucun projet disponible pour le moment.' }}
			</div>
		{% endfor %}
	</div>
</section>



	</section>
{% endblock %}
