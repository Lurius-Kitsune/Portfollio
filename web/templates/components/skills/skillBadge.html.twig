{% set badgeClasses = item.color|default('bg-white text-slate-800') %}
<div class="group inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 shadow-lg shadow-slate-950/20 transition-transform duration-200 hover:-translate-y-1 {{ badgeClasses }}">
	<span class="text-lg font-black leading-none tracking-tight">
		{% if item.icon is defined and item.icon %}
			{{ item.icon|raw }}
		{% else %}
			{{ item.short|default(item.label|first|upper) }}
		{% endif %}
	</span>
</div>
