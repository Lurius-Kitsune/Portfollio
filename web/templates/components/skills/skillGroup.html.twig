<section class="space-y-5">
	<div class="flex items-center gap-3">
		<div class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-xl text-cyan-300 ring-1 ring-white/10">
			{{ group.icon|raw }}
		</div>
		<h3 class="text-2xl font-black tracking-tight text-white md:text-3xl">{{ group.title }}</h3>
	</div>

	<div class="flex flex-wrap gap-3">
		{% for item in group.items %}
			{% include 'components/skills/skillBadge.html.twig' with { item: item } %}
		{% endfor %}
	</div>
</section>
