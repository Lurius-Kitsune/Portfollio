{% block projectFormBlock %}
    {{ form_start(projectForm, {
            attr: {
                'data-action': 'submit->project-editor#save'
            }
        }) }}


        <div class="mx-auto max-w-5xl px-6 py-20">

            {# HEADER #}
            <div class="mb-10 flex items-center justify-between">
                <div>
                    <span class="text-sm font-semibold uppercase tracking-widest text-gray-500">
                        Administration
                    </span>

                    <h2 class="mt-2 text-3xl font-bold">
                        Modifier le projet
                    </h2>
                </div>

                <button
                    type="button"
                    data-action="click->project-editor#cancel"
                    class="rounded-md border border-gray-700 px-4 py-2 text-sm text-gray-300 transition hover:bg-gray-800"
                >
                    Annuler
                </button>
            </div>

            {# NOM #}
            <div class="mb-6">
                {{ form_label(projectForm.name, 'Nom du projet', {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-gray-300'
                        }
                    }) }}

                {{ form_widget(projectForm.name, {
                        attr: {
                            class: 'w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-white focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400'
                        }
                    }) }}

                {{ form_errors(projectForm.name) }}
            </div>

            {# DATE DE DÉBUT #}
            <div class="mb-6">
                {{ form_label(projectForm.start_year, 'Début du projet', {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-gray-300'
                        }
                    }) }}

                {{ form_widget(projectForm.start_year, {
                        attr: {
                            class: 'w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-white focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400'
                        }
                    }) }}

                {{ form_errors(projectForm.start_year) }}
            </div>

            {# DATE DE FIN #}
            <div class="mb-6">
                {{ form_label(projectForm.end_date, 'Fin du projet', {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-gray-300'
                        }
                    }) }}

                {{ form_widget(projectForm.end_date, {
                        attr: {
                            class: 'w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-white focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400'
                        }
                    }) }}

                {{ form_errors(projectForm.end_date) }}
            </div>

            {# ROLE #}
            <div class="mb-6">
                {{ form_label(projectForm.role, 'Rôle', {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-gray-300'
                        }
                    }) }}

                {{ form_widget(projectForm.role, {
                        attr: {
                            class: 'w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-white focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400'
                        }
                    }) }}

                {{ form_errors(projectForm.role) }}
            </div>

            {# INTRODUCTION #}
            <div class="mb-10">
                {{ form_label(projectForm.intro, 'Introduction', {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-gray-300'
                        }
                    }) }}

                {{ form_widget(projectForm.intro, {
                        attr: {
                            rows: 5,
                            class: 'w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-white focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400'
                        }
                    }) }}

                {{ form_errors(projectForm.intro) }}
            </div>

            {# CONCLUSION #}
            <div class="mb-10">
                <h3 class="mb-6 text-xl font-bold">
                    Conclusion
                </h3>

                {# TITRE #}
                <div class="mb-4">
                    {{ form_label(projectForm.conclusionTitle, 'Titre', {
                            label_attr: {
                                class: 'mb-2 block text-sm text-gray-400'
                            }
                        }) }}

                    {{ form_widget(projectForm.conclusionTitle, {
                            attr: {
                                class: 'w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-white focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400'
                            }
                        }) }}

                    {{ form_errors(projectForm.conclusionTitle) }}
                </div>

                {# CONTENU TIPTAP #}
                <div>
                    <label class="mb-2 block text-sm text-gray-400">
                        Paragraphes
                    </label>

                    {# Champ Symfony qui recevra le JSON TipTap #}
                    {{ form_widget(projectForm.conclusionContent, {
                            attr: {
                                'data-project-editor-target': 'conclusionContent',
                                'class': 'hidden'
                            }
                        }) }}

                    {# Éditeur TipTap #}
                    <div
                        data-project-editor-target="conclusionText"
                        data-controller="rich-text-editor"
                        data-rich-text-editor-content-value="{{ project.conclusionContent|json_encode|e('html_attr') }}"
                    >
                        {% include "components/richTextEditor.html.twig" %}
                    </div>

                    {{ form_errors(projectForm.conclusionContent) }}
                </div>
            </div>

            {# THUMBNAIL #}
            <div class="mb-6">
                {{ form_label(projectForm.thumbnail_url, 'URL de la miniature', {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-gray-300'
                        }
                    }) }}

                {{ form_widget(projectForm.thumbnail_url, {
                        attr: {
                            class: 'w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-white focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400'
                        }
                    }) }}

                {{ form_errors(projectForm.thumbnail_url) }}
            </div>

            {# LIEN #}
            <div class="mb-6">
                {{ form_label(projectForm.link, 'Lien du projet', {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-gray-300'
                        }
                    }) }}

                {{ form_widget(projectForm.link, {
                        attr: {
                            class: 'w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-white focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400'
                        }
                    }) }}

                {{ form_errors(projectForm.link) }}
            </div>

            {# TAGS #}
            <div class="mb-6">
                {{ form_label(projectForm.tags, 'Tags', {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-gray-300'
                        }
                    }) }}

                {{ form_widget(projectForm.tags, {
                        attr: {
                            class: 'w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-white focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400'
                        }
                    }) }}

                {{ form_errors(projectForm.tags) }}
            </div>

            {# TYPE #}
            <div class="mb-6">
                {{ form_label(projectForm.type, 'Type de projet', {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-gray-300'
                        }
                    }) }}

                {{ form_widget(projectForm.type, {
                        attr: {
                            class: 'w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-white focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400'
                        }
                    }) }}

                {{ form_errors(projectForm.type) }}
            </div>

            {# VISIBILITÉ #}
            <div class="mb-6 flex gap-8">
                <div>
                    {{ form_widget(projectForm.isVisible) }}

                    {{ form_label(projectForm.isVisible, 'Visible', {
                            label_attr: {
                                class: 'ml-2 text-sm text-gray-300'
                            }
                        }) }}

                    {{ form_errors(projectForm.isVisible) }}
                </div>

                <div>
                    {{ form_widget(projectForm.isReadable) }}

                    {{ form_label(projectForm.isReadable, 'Lisible', {
                            label_attr: {
                                class: 'ml-2 text-sm text-gray-300'
                            }
                        }) }}

                    {{ form_errors(projectForm.isReadable) }}
                </div>
            </div>

            {# ACTIONS #}
            <div class="flex justify-end gap-3 border-t border-gray-800 pt-6">

                <button
                    type="button"
                    data-action="click->project-editor#cancel"
                    class="rounded-lg border border-gray-700 px-5 py-3 font-medium text-gray-300 transition hover:bg-gray-800"
                >
                    Annuler
                </button>

                <button
                    type="submit"
                    data-project-editor-target="saveButton"
                    class="rounded-lg bg-cyan-500 px-5 py-3 font-semibold text-slate-950 transition hover:bg-cyan-300"
                >
                    Enregistrer
                </button>

            </div>

    </div>

    {{ form_end(projectForm) }}
{% endblock %}
