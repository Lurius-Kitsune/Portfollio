{{ form_start(mediaForm, {
    attr: {
        'data-media-target': 'mediaForm',
        'data-action': 'submit->media#submitMedia'
    }
}) }}

<div class="rounded-2xl border border-cyan-500/30 bg-gray-900 p-6">

    <div class="mb-6 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-white">
            Ajouter un média
        </h3>
    </div>

    {# ===== Bannière d'erreur ===== #}
    {% include 'components/banner/errorBanner.html.twig' with {
        attributes: {
            'data-media-target': 'mediaErrorBanner'
        },
        messages: []
    } %}

    {# ===== Nom ===== #}
    <div class="mb-5">
        {{ form_label(mediaForm.name, 'Nom', {
            label_attr: { class: 'mb-2 block text-sm font-medium text-gray-300' }
        }) }}
        {{ form_widget(mediaForm.name, {
            attr: {
                class: 'w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white outline-none focus:border-cyan-500',
                placeholder: 'Ex : Capture écran accueil'
            }
        }) }}
        {{ form_errors(mediaForm.name) }}
    </div>

    {# ===== Toggle Fichier / URL ===== #}
    <div class="mb-5">
        <span class="mb-2 block text-sm font-medium text-gray-300">
            Source du média
        </span>

        <div class="inline-flex rounded-lg border border-gray-700 bg-gray-950 p-1" role="group">
            <button
                type="button"
                data-action="click->media#showFileMode"
                data-media-target="fileModeButton"
                class="rounded-md px-4 py-1.5 text-sm font-medium text-gray-400 transition"
            >
                Fichier
            </button>
            <button
                type="button"
                data-action="click->media#showUrlMode"
                data-media-target="urlModeButton"
                class="rounded-md px-4 py-1.5 text-sm font-medium text-gray-400 transition"
            >
                URL
            </button>
        </div>
    </div>

    {# ===== Champ fichier ===== #}
    <div data-media-target="fileField" class="mb-6">
        {{ form_label(mediaForm.file, 'Fichier', {
            label_attr: { class: 'mb-2 block text-sm font-medium text-gray-300' }
        }) }}
        {{ form_widget(mediaForm.file, {
            attr: {
                class: 'block w-full cursor-pointer rounded-lg border border-gray-700 bg-gray-950 text-sm text-gray-300 file:mr-4 file:cursor-pointer file:border-0 file:bg-cyan-500 file:px-4 file:py-3 file:text-sm file:font-semibold file:text-slate-950 hover:file:bg-cyan-300',
                accept: 'image/*,video/*'
            }
        }) }}
        {{ form_errors(mediaForm.file) }}
    </div>

    {# ===== Champ URL ===== #}
    <div data-media-target="urlField" class="mb-6 hidden">
        {{ form_label(mediaForm.url, 'URL', {
            label_attr: { class: 'mb-2 block text-sm font-medium text-gray-300' }
        }) }}
        {{ form_widget(mediaForm.url, {
            attr: {
                class: 'w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white outline-none focus:border-cyan-500',
                placeholder: 'https://exemple.com/image.jpg'
            }
        }) }}
        {{ form_errors(mediaForm.url) }}
    </div>

    <div class="mt-4">
        {{ form_label(mediaForm.type, 'Type', {
            label_attr: { class: 'mb-2 block text-sm font-medium text-gray-300' }
        }) }}
        {{ form_widget(mediaForm.type, {
            attr: {
                class: 'w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white outline-none focus:border-cyan-500'
            }
        }) }}
        {{ form_errors(mediaForm.type) }}
    </div>
    {# ===== Action ===== #}
    <div class="pt-2 flex justify-end gap-3">
        <button
            type="submit"
            data-media-target="mediaSubmitButton"
            class="cursor-pointer rounded-lg bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300 disabled:cursor-not-allowed disabled:opacity-50"
        >
            Ajouter le média
        </button>
    </div>

</div>

{{ form_end(mediaForm) }}