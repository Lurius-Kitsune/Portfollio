{% block content %}

    <section
        id="project-content-{{ content.id }}"
        data-content-id="{{ content.id }}"
        data-project-editor-target="contentBlock"
        class="border-t border-gray-800 {% if loopId % 2 != 0 %}bg-gray-900/30{% endif %}"
    >
        <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">

            {# ========================= #}
            {# AFFICHAGE NORMAL          #}
            {# ========================= #}

            <div data-project-editor-target="contentDisplay" class="grid items-center gap-12 lg:grid-cols-2">

                {% if loopId % 2 == 0 %}

                    <div>
                        <span
                            class="text-sm font-semibold uppercase tracking-widest text-gray-500"
                        >
                            {{ loopId + 1 }} ·
                            <span data-project-editor-target="contentThemeDisplay">
                                {{ content.themeName }}
                            </span>
                        </span>

                        <h2
                            data-project-editor-target="contentTitleDisplay"
                            class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
                        >
                            {{ content.title }}
                        </h2>

                        <div data-project-editor-target="contentTextDisplay">
                            {% for text in content.content %}
                                <p class="mt-6 leading-7 text-gray-400">
                                    {{ text }}
                                </p>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="overflow-hidden rounded-2xl border border-gray-800 bg-gray-900">
                        <div class="flex aspect-video items-center justify-center">
                            {% if content.linkMedia is not empty %}
                                {% include "pages/project/carouselle.html.twig" with {
                                    medias: content.linkMedia
                                } %}
                            {% endif %}
                        </div>
                    </div>

                {% else %}

                    <div class="order-2 overflow-hidden rounded-2xl border border-gray-800 bg-gray-900 lg:order-1">
                        <div class="flex aspect-video items-center justify-center">
                            {% if content.linkMedia is not empty %}
                                {% include "pages/project/carouselle.html.twig" with {
                                    medias: content.linkMedia
                                } %}
                            {% endif %}
                        </div>
                    </div>

                    <div class="order-1 lg:order-2">
                        <span
                            class="text-sm font-semibold uppercase tracking-widest text-gray-500"
                        >
                            {{ loopId + 1 }} ·
                            <span data-project-editor-target="contentThemeDisplay">
                                {{ content.themeName }}
                            </span>
                        </span>

                        <h2
                            data-project-editor-target="contentTitleDisplay"
                            class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
                        >
                            {{ content.title }}
                        </h2>

                        <div data-project-editor-target="contentTextDisplay">
                            {% for text in content.content %}
                                <p class="mt-6 leading-7 text-gray-400">
                                    {{ text }}
                                </p>
                            {% endfor %}
                        </div>
                    </div>

                {% endif %}

            </div>


            {# ========================= #}
            {# MODE ÉDITION               #}
            {# ========================= #}

            {% include "components/project/editContent.html.twig" %}

            {% if is_granted('ROLE_ADMIN') %}
                {# Bouton modifier #}
                <div class="mt-6 flex justify-end">
                    <button
                        type="button"
                        data-action="click->project-editor#editContent"
                        class="rounded-lg border border-gray-700 px-4 py-2 text-sm font-medium text-gray-300 transition hover:border-cyan-500 hover:text-cyan-300"
                    >
                        Modifier cette section
                    </button>
                    <button
                        type="button"
                        data-action="click->project-editor#deleteContent"
                        class="ml-1 rounded-lg border border-red-900/50 px-4 py-2 text-sm font-medium text-red-400 transition hover:bg-red-950 hover:text-red-300"
                    >
                        Supprimer
                    </button>
                </div>

            {% endif %}
        
        </div>
    </section>

{% endblock %}