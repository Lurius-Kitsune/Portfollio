{% block details %}

    <div
        data-controller="project-editor"
        data-project-editor-update-url-value="{{ path('project_patch', {
            slug: project.slug
        }) }}"
        data-project-editor-create-content-url-value="{{ path('project_content_create', {
            slug: project.slug
        }) }}"
        data-project-editor-project-slug-value="{{ project.slug }}"
    >

        {# ============================================================
        MODE AFFICHAGE
        ============================================================ #}

        <div data-project-editor-target="display">

            <div class="bg-gray-950 text-white">

                {# ROLE + INTRO #}
                <section class="relative overflow-hidden">
                    <div class="mx-auto px-6 py-20 lg:px-8">
                        <div class="mx-auto text-center">

                            <span
                                data-project-editor-target="roleDisplay"
                                class="mb-4 inline-flex items-center rounded-full border border-gray-700 bg-gray-900 px-4 py-1.5 text-sm font-medium text-gray-300"
                            >
                                {{ project.role }}
                            </span>

                            <p
                                data-project-editor-target="introDisplay"
                                class="mt-2 text-lg leading-8 text-gray-400"
                            >
                                {{ project.intro }}
                            </p>

                        </div>
                    </div>
                </section>


                {# CONTENUS #}
                <div data-project-editor-target="contentsContainer">
                    {% for content in project.projectContents %}
                    
                        {% include "components/project/content.html.twig" with {content: content, loopId: loop.index0} %}
                    
                    {% endfor %}
                </div>
                {% if is_granted('ROLE_ADMIN') %}

                    <div class="mx-auto max-w-7xl px-6 py-12 border-t border-gray-800">

                        <button
                            type="button"
                            data-action="click->project-editor#openCreateContent"
                            class="w-full rounded-2xl border border-dashed border-gray-700 bg-gray-900/50 px-6 py-8 text-center text-gray-400 transition hover:border-cyan-500 hover:bg-gray-900 hover:text-cyan-300"
                        >
                            <span class="text-2xl">+</span>

                            <span class="mt-2 block font-medium">
                                Ajouter une section
                            </span>
                        </button>

                    </div>

                    {% include "components/project/createContent.html.twig" %}

                {% endif %}
                {# CONCLUSION #}
                {% if project.conclusionTitle is not empty or project.conclusionContent is not empty %}

                    <section class="border-t border-gray-800">
                        <div class="mx-auto max-w-4xl px-6 py-24 text-center lg:px-8">

                            <span class="text-sm font-semibold uppercase tracking-widest text-gray-500">
                                Conclusion
                            </span>

                            <h2
                                data-project-editor-target="conclusionTitleDisplay"
                                class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
                            >
                                {{ project.conclusionTitle }}
                            </h2>

                            <div data-project-editor-target="conclusionContentDisplay">
                                <div
                                    data-controller="rich-text-renderer"
                                    data-rich-text-renderer-content-value="{{ project.conclusionContent|json_encode|e('html_attr') }}"
                                    class="
                                tiptap-content
                                mt-6
                                leading-7
                                text-gray-400
                                [&_p]:mt-3
                                [&_p:first-child]:mt-0
                                [&_p:empty]:min-h-7
                            "
                                >
                                    <div
                                        data-rich-text-renderer-target="content"
                                    ></div>
                                </div>

                            </div>

                        </div>
                    </section>

                {% endif %}

            </div>


            {# BOUTON MODIFIER #}
            {% if is_granted('ROLE_ADMIN') %}

                <button
                    type="button"
                    data-action="click->project-editor#edit"
                    class="fixed bottom-6 right-6 rounded-full bg-cyan-500 px-5 py-3 font-semibold text-slate-950 shadow-lg transition hover:bg-cyan-300"
                >
                    Modifier
                </button>

            {% endif %}

        </div>


        {# ============================================================
       MODE ÉDITION
       ============================================================ #}

        {% include "components/project/editDetails.html.twig" %}

    </div>

{% endblock %}