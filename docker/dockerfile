# =========== Base for dev & prod ===========
FROM php:8.5-fpm-alpine AS base

RUN apk add --no-cache --virtual .build-deps \
    unzip \
    zip \
    libpng-dev \
    icu-dev \
    libzip-dev \
    libpq-dev \
    $PHPIZE_DEPS \
    && docker-php-ext-install pdo_pgsql zip gd intl\
    && apk del .build-deps \
    && apk add --no-cache libpng libzip postgresql-client icu-libs

WORKDIR /var/www/portfolio

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# =========== DEV STEP ===========
FROM base AS dev

### XDEBUG ####
RUN apk add --no-cache --virtual .xdebug-deps linux-headers $PHPIZE_DEPS\
    pecl install xdebug \
    && docker-php-ext-enable xdebug

COPY docker/xdebug/xdebug.ini /usr/local/etc/php/conf.d/xdebug.ini
### XDEBUG ####


CMD ["php-fpm"]


# =========== BUILD STEP ===========
FROM base AS builder 

RUN apk add --no-cache nodejs npm

# Dépendances PHP en premier — invalidé seulement si composer.lock change
COPY web/composer.json web/composer.lock ./
RUN COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --no-scripts --no-autoloader

# Dépendances JS ensuite — invalidé seulement si package-lock.json change
COPY web/package.json web/package-lock.json ./
RUN npm install

# Le code source en dernier — c'est lui qui change le plus souvent
COPY web/ /var/www/portfolio

RUN COMPOSER_ALLOW_SUPERUSER=1 composer dump-autoload --optimize
RUN npm run build

# node_modules ne sert plus une fois les assets compilés
RUN rm -rf node_modules

#=========== PROD ===========
FROM base AS prod

COPY --from=builder --chown=www-data:www-data /var/www/portfolio /var/www/portfolio

# RUN chown -R www-data:www-data /var/www/portfolio

RUN APP_ENV=prod php bin/console cache:clear --no-warmup

CMD ["php-fpm"]