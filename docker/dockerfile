FROM php:8.5-fpm

RUN apt-get update && apt-get install -y \
    git \
    unzip \
    zip \
    libpng-dev \
    libzip-dev \
    default-mysql-client 
    
RUN docker-php-ext-install pdo_mysql zip gd pdo 

WORKDIR /var/www/portfolio

COPY web/ /var/www/portfolio

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

RUN COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --no-scripts

RUN chown -R www-data:www-data /var/www/portfolio

CMD ["php-fpm"]